# SPDX-License-Identifier: AGPL-3.0-only
# Names only. Copy to .env (git-ignored) and fill in locally.
# In production, values live in Render's secret store, never in git.
PRANIX_ENV=dev
# Relative to where you run the app (backend/), so ../data/ephe
PRANIX_EPHE_PATH=../data/ephe
PRANIX_GEO_DB_PATH=../data/geonames.sqlite
PRANIX_FONTS_DIR=../data/fonts
# Built React app; leave unset in dev (use npm run dev on :5173). Docker sets /app/web.
# PRANIX_WEB_DIST=../web/dist
PRANIX_FEATURE_CHAT=false
PRANIX_FEATURE_PASSKEYS=false
PRANIX_DATABASE_URL=
PRANIX_GEMINI_API_KEY=
PRANIX_GROQ_API_KEY=
# Local model (F5). On the PC with Ollama:  ollama pull gemma4:e2b
#   PRANIX_LOCAL_LLM_URL=http://localhost:11434/v1
#   PRANIX_LOCAL_LLM_MODEL=gemma4:e2b
# Chain: default = Gemini -> Groq -> local; dev = local only (offline, free); cloud = no local model
#   PRANIX_LLM_CHAINS=dev   (cards then queue for Gemma one at a time; the first dashboard takes a few minutes, then the cache makes it instant)
# On the Oracle VM the same settings point at http://llm:8080/v1 with PRANIX_LOCAL_LLM_API_KEY.
# Background re-wording (D77, on by default when a local model is set): a card served as library text
#   is re-worded by Gemma later, one at a time, and cached for the next reader.  PRANIX_BACKGROUND_REWORD=false turns it off.
# Try it:  pranix-ctl llm check     Measure it:  pranix-ctl llm bench
# Peppers: random secrets you make yourself (32+ characters; required in prod, random per run in dev):
#   python -c "import secrets; print(secrets.token_hex(32))"
PRANIX_LOG_PEPPER=
PRANIX_CHART_KEY_PEPPER=
