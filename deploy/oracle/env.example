# Copy to deploy/oracle/.env on the server, fill in, then: chmod 600 .env
# This file is a template only. Real values never go into git.

# Public name (DuckDNS) that points at this server
PRANIX_DOMAIN=pranix.duckdns.org

PRANIX_ENV=prod
# 64 random characters each, different from each other:  openssl rand -hex 32
PRANIX_LOG_PEPPER=
PRANIX_CHART_KEY_PEPPER=

# Optional AI providers (free tiers). Without them every card shows reviewed library text.
PRANIX_GEMINI_API_KEY=
PRANIX_GROQ_API_KEY=

# Production serves only owner-approved library entries (FR-LIB-03). Turning drafts on for a
# public site is the owner's decision; leave this commented out unless you have decided that.
# PRANIX_LIBRARY_ALLOW_DRAFTS=true

# Local model (only with: docker compose --profile llm up -d). Internal only.
LLM_API_KEY=
# LLM_MODEL=ggml-org/gemma-4-E4B-it-GGUF:Q4_K_M

# Accounts database (only with: docker compose --profile accounts up -d). Internal only.
# POSTGRES_PASSWORD=                      # openssl rand -hex 24
# PRANIX_DATABASE_URL=postgresql://pranix:<POSTGRES_PASSWORD>@db:5432/pranix
# Backups (deploy/oracle/backup.sh): a passphrase file outside the repo, and the bucket name.
# BACKUP_KEY_FILE=/etc/pranix/backup.key  # openssl rand -hex 32 > that file; chmod 600; keep a copy off the server
# BACKUP_TARGET=oci://pranix-backups      # or dir:/some/local/folder for a test
