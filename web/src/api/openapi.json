    "/v1/profiles/{profile_id}/dasha": {
      "get": {
        "description": "No path: the nine Mahadashas; path 'Ju>Ve': its nine children. Max depth five.",
        "operationId": "dasha_periods_v1_profiles__profile_id__dasha_get",
        "parameters": [
          {
            "in": "path",
            "name": "profile_id",
            "required": true,
            "schema": {
              "title": "Profile Id",
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "path",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "pattern": "^[A-Z][a-z](>[A-Z][a-z]){0,3}$",
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Path"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "additionalProperties": true,
                    "type": "object"
                  },
                  "title": "Response Dasha Periods V1 Profiles  Profile Id  Dasha Get",
                  "type": "array"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
